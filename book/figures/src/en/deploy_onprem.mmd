      Container(api1, "Transfer service", ".NET 10")
      ContainerDb(db1, "Primary ledger", "SQL")
    }
  }
  Deployment_Node(dc2, "Secondary data centre", "Customer") {
    Deployment_Node(srv2, "Second unit", "Capacity to run the service alone") {
      Container(api2, "Standby service", ".NET 10")
