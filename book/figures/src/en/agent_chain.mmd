flowchart TB
  owner(("Business authority")) --> scope["Mandate and policies"]
  scope --> inv["Capabilities and contracts"]
  legacy["Authorized legacy system"] --> obs["Golden Master: observed behavior"]
  inv --> rules["Hypotheses and exceptions"]
  obs -. "Characterizes; does not approve" .-> rules
  inv -. "Only for technical uncertainty" .-> parse["Optional COBOL/JCL investigation"]
  parse -. "Provenance-linked findings" .-> rules
  rules --> spec["Specification and test cases"]
  spec --> owner
  owner --> base[("Approved functional baseline")]
  base --> arch["Domain-based architecture"]
  arch --> build["New implementation (brownfield)"]
  build --> transition["Coexistence and reconciliation"]
  transition --> ver["Independent TODM oracles"]
  base --> ver
  obs -. "Separate comparison" .-> ver
  ver --> release["G6: human decision"]
  release --> drift["G7: drift control"]
  drift -. "Review rules" .-> owner
  build -. "cannot modify" .-x base
